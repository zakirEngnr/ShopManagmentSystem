PORT=4000
# Host the backend binds to. Defaults to 127.0.0.1 so the app is only reachable
# from this machine. Only change to 0.0.0.0 if you deliberately want other
# devices on the shop network to connect.
HOST=127.0.0.1
DATABASE_URL="file:./shop.db"
JWT_SECRET="CHANGE_ME_generate_with_node_-e_crypto_randomBytes_48_hex"
UPLOAD_DIR="./uploads"
ADMIN_EMAIL="admin@shop.local"
ADMIN_PASSWORD="CHANGE_ME_at_least_12_characters"
