{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --import ./test-support/guard-bootstrap.mjs",
    "test:db-guard": "node --test --import ./test-support/guard-bootstrap.mjs test/db-isolation.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "db:reconcile": "node scripts/db-reconcile/reconcile.mjs",
    "db:reconcile:test": "node --test --import ./test-support/guard-bootstrap.mjs scripts/db-reconcile/test/reconcile.test.mjs scripts/db-reconcile/test/rebuild-interruption.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
