generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String
  role           String    @default("ADMIN")
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  tokenVersion   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

model Setting {
  key   String @id
  value String
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  type      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           Int           @id @default(autoincrement())
  sku          String        @unique
  barcode      String?       @unique
  name         String
  type         String
  costPrice    Float
  sellPrice    Float
  stock        Int           @default(0)
  lowStockAt   Int           @default(5)
  expiryDate   DateTime?
  imageUrl     String?
  categoryId   Int
  brandId      Int?
  category     Category      @relation(fields: [categoryId], references: [id])
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  saleItems    SaleItem[]
  stockAdjusts StockAdjust[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([barcode])
  @@index([type])
}

model Sale {
  id              Int        @id @default(autoincrement())
  invoiceNo       String     @unique
  subtotal        Float
  discount        Float      @default(0)
  total           Float
  recognizedAmount Float     @default(0)
  paymentMethod   String
  customerId      Int?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  khataTransactions KhataTransaction[]
  items           SaleItem[]
  paymentAllocations PaymentAllocation[]
  createdAt       DateTime   @default(now())

  @@index([customerId])
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  productId  Int?
  manualName String?
  quantity   Int
  unitPrice  Float
  unitCost   Float?
  total      Float
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model StockAdjust {
  id        Int      @id @default(autoincrement())
  productId Int
  delta     Int
  reason    String
  unitCost  Float?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  category    String
  expenseName String?   // Named expense head/payee (e.g. Lunch, Rent, Fazil)
  description String
  amount      Float
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([expenseName])
}

model Customer {
  id           Int                @id @default(autoincrement())
  name         String
  phone        String?            @unique
  email        String?
  address      String?
  notes        String?
  balance      Float              @default(0)
  type         String             @default("RETAIL")
  transactions KhataTransaction[]
  sales        Sale[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([name])
  @@index([type])
}

model KhataTransaction {
  id          Int      @id @default(autoincrement())
  customerId  Int
  type        String
  amount      Float
  description String?
  saleId      Int?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  paymentAllocations PaymentAllocation[]
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([saleId])
}

model PaymentAllocation {
  id        Int @id @default(autoincrement())
  paymentId Int   // FK to KhataTransaction (type PAYMENT)
  saleId    Int   // FK to Sale being settled
  amount    Float // Amount allocated from the payment to this sale
  createdAt DateTime @default(now())

  payment KhataTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([paymentId, saleId])
  @@index([paymentId])
  @@index([saleId])
}
